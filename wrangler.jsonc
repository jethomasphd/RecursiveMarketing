{
  "$schema": "node_modules/wrangler/config-schema.json",
  // API Worker only. The static site in public/ is served by the SEPARATE
  // Cloudflare Pages project "recursive-marketing" (recursive-marketing.pages.dev),
  // which auto-deploys from GitHub. Deploying this config does NOT touch Pages,
  // and `/` on the workers.dev URL returning 404 is expected — the Worker only
  // answers /chat, /health and /geo.
  "name": "recursive-marketing-worker",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": ""
  }
  // Secrets — set once via the Cloudflare Dashboard or wrangler:
  //   wrangler secret put ANTHROPIC_API_KEY
  //   wrangler secret put USAJOBS_API_KEY
  //   wrangler secret put USAJOBS_EMAIL
  //
  // Get a USAJobs API key at: https://developer.usajobs.gov/APIRequest/Index
  //   USAJOBS_EMAIL   = the email you registered with
  //   USAJOBS_API_KEY = the API key they email you
}
